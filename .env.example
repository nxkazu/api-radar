# --- Core ---
APIRADAR_DATABASE_URL=postgresql+psycopg://apiradar:apiradar@localhost:5432/apiradar
APIRADAR_REDIS_URL=redis://localhost:6379/0

# --- GitHub ---
# Personal access token fallback for local use. A GitHub App is preferred.
APIRADAR_GITHUB_TOKEN=
# GitHub App credentials (App ID + path/PEM contents of the private key)
APIRADAR_GITHUB_APP_ID=
APIRADAR_GITHUB_APP_PRIVATE_KEY=
APIRADAR_GITHUB_WEBHOOK_SECRET=change-me

# --- Behaviour ---
# Open a PR with the migration report (and mechanical path renames) after a breaking scan.
APIRADAR_AUTO_PR=false
# How often the beat worker rescans every tracked spec.
APIRADAR_SCAN_INTERVAL_MINUTES=360
# Run Celery tasks inline (useful for tests and single-process demos).
APIRADAR_CELERY_TASK_ALWAYS_EAGER=false